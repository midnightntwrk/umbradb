+/// UmbraDB: the byte length of an output's ciphertext as `preimage_evidence_parts` gives it: the
+/// point (32 bytes) and the six elements (32 bytes each).
+const COIN_CIPHERTEXT_BYTES: usize = 32 + 6 * 32;
+
+/// UmbraDB: a zswap output's preimage evidence, read from the event and changed in nothing: its kind
+/// (`ciphertext`, `publicPreimage` or `none`) and, for a ciphertext, its 224 bytes: the point's
+/// 32-byte compressed encoding (the bytes its `Serializable` writes), then each of the six
+/// elements as its 32-byte little-endian integer (`Fr::as_le_bytes`, zero-padded to 32).
+fn preimage_evidence_parts(
+    evidence: &ledger::events::ZswapPreimageEvidence,
+) -> Result<(String, Option<serde_bytes::ByteBuf>), JsError> {
+    use ledger::events::ZswapPreimageEvidence as E;
+    match evidence {
+        E::Ciphertext(ciphertext) => {
+            let mut bytes = Vec::with_capacity(COIN_CIPHERTEXT_BYTES);
+            Serializable::serialize(&ciphertext.c, &mut bytes)?;
+            if bytes.len() != 32 {
+                return Err(JsError::new("a ciphertext's point does not serialize to 32 bytes"));
+            }
+            for element in ciphertext.ciph.iter() {
+                let le = element.as_le_bytes();
+                if le.len() > 32 {
+                    return Err(JsError::new("a ciphertext element is longer than 32 bytes"));
+                }
+                let mut word = [0u8; 32];
+                word[..le.len()].copy_from_slice(&le);
+                bytes.extend_from_slice(&word);
+            }
+            if bytes.len() != COIN_CIPHERTEXT_BYTES {
+                return Err(JsError::new("a ciphertext is not 224 bytes"));
+            }
+            Ok(("ciphertext".to_string(), Some(serde_bytes::ByteBuf::from(bytes))))
+        }
+        E::PublicPreimage { .. } => Ok(("publicPreimage".to_string(), None)),
+        E::None => Ok(("none".to_string(), None)),
+    }
+}
