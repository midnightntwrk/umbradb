+#[cfg(not(target_arch = "wasm32"))]
 use std::time::Instant;
 
+/// `std::time::Instant::now` panics on `wasm32-unknown-unknown`. The timings taken in this module
+/// only feed the profiling counters (`TDEP`, `TFIN`, `TPROCESS`, `TUPDATE`) and never the
+/// translation itself, so on that target every timing reads as zero.
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Copy)]
+struct Instant;
+
+#[cfg(target_arch = "wasm32")]
+impl Instant {
+    fn now() -> Self {
+        Instant
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+impl std::ops::Sub for Instant {
+    type Output = std::time::Duration;
+    fn sub(self, _earlier: Instant) -> std::time::Duration {
+        std::time::Duration::ZERO
+    }
+}
