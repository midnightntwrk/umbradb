+
+// LG-16's tree values (UmbraDB task 12.1b, owner decision Q138 A): what the official indexer stores
+// of a ledger state besides its root, read from the state as it reads them (`midnight-indexer`
+// `indexer-common/src/domain/ledger/ledger_state.rs`: `zswap_first_free`,
+// `zswap_merkle_tree_root`, `dust_commitments_first_free`, `dust_commitment_merkle_tree_root`,
+// `dust_generations_first_free`, `dust_generation_merkle_tree_root`). The published package gives
+// the zswap tree's first free index only.
+
+/// A Merkle tree's root after `rehash()`, in the ledger's untagged serialization, as the official
+/// indexer stores it; an error where the tree has no root (the indexer's `expect`).
+fn tree_root<T: Serializable>(root: Option<T>, tree: &str) -> Result<Uint8Array, JsError> {
+    let root =
+        root.ok_or_else(|| JsError::new(&format!("stateTrees: the {tree} tree has no root")))?;
+    let mut bytes = Vec::new();
+    Serializable::serialize(&root, &mut bytes)?;
+    Ok(Uint8Array::from(&bytes[..]))
+}
+
+/// The state's zswap commitment tree's first free index and root, and its DUST commitment and
+/// generation trees' first free indexes and roots: `{ zswapFirstFree, zswapRoot,
+/// dustCommitmentFirstFree, dustCommitmentRoot, dustGenerationFirstFree, dustGenerationRoot }`,
+/// each index a `bigint`, each root its tree's root after `rehash()` in the ledger's untagged
+/// serialization.
+#[wasm_bindgen(js_name = "stateTrees")]
+pub fn state_trees(state: &LedgerState) -> Result<JsValue, JsError> {
+    report_panics();
+    let state = &state.0;
+    let result = Object::new();
+    set_field(&result, "zswapFirstFree", &BigInt::from(state.zswap.first_free).into())?;
+    set_field(
+        &result,
+        "zswapRoot",
+        &tree_root(state.zswap.coin_coms.rehash().root(), "zswap commitment")?.into(),
+    )?;
+    set_field(
+        &result,
+        "dustCommitmentFirstFree",
+        &BigInt::from(state.dust.utxo.commitments_first_free).into(),
+    )?;
+    set_field(
+        &result,
+        "dustCommitmentRoot",
+        &tree_root(state.dust.utxo.commitments.rehash().root(), "DUST commitment")?.into(),
+    )?;
+    set_field(
+        &result,
+        "dustGenerationFirstFree",
+        &BigInt::from(state.dust.generation.generating_tree_first_free).into(),
+    )?;
+    set_field(
+        &result,
+        "dustGenerationRoot",
+        &tree_root(state.dust.generation.generating_tree.rehash().root(), "DUST generation")?.into(),
+    )?;
+    Ok(result.into())
+}
