+
+/// Converts the ledger v8 state whose root node has key `v8StateKey` to a ledger v9 state with the
+/// ledger team's v8 → v9 state translation (`v8-to-v9-state-translation`), reading nodes from
+/// `store` as `loadState` does, with the step budget the node uses.
+#[wasm_bindgen(js_name = "convertFromV8")]
+pub fn convert_from_v8(v8_state_key: &Uint8Array, store: JsValue) -> Result<LedgerState, JsError> {
+    report_panics();
+    let key = parse_key(v8_state_key)?;
+    install_store(store)?;
+    let v8_state = load_root::<V8LedgerState>(&key, "convertFromV8")?;
+    let mut translation = TypedTranslationState::<
+        V8LedgerState,
+        V9LedgerState,
+        StateTranslationTable,
+        InMemoryDB,
+    >::start(Sp::new(v8_state))?;
+    let budget = CostDuration::from_picoseconds(TRANSLATION_STEP_BUDGET_PS);
+    for _ in 0..TRANSLATION_MAX_STEPS {
+        translation = translation.run(budget)?;
+        if let Some(result) = translation.result()? {
+            return Ok(LedgerState((*result).clone()));
+        }
+    }
+    Err(JsError::new(&format!(
+        "convertFromV8: the translation did not finish in {TRANSLATION_MAX_STEPS} steps"
+    )))
+}
