+ledger-v8 = { package = "midnight-ledger", version = "=8.1.3", default-features = false }
+# UmbraDB: the ledger team's v8 -> v9 state translation, at the revision the node pins
+# (midnight-node 2.1.101, Cargo.toml: tag state-translation-v8-v9-node-2.1.101); its crates.io v9
+# dependencies resolve to this workspace through [patch.crates-io].
+v8-to-v9-state-translation = { git = "https://github.com/midnightntwrk/midnight-ledger", rev = "39cfd0531524b87e53198ce136777530c29646aa" }
 serialize = { path = "../serialize", package = "midnight-serialize" }
