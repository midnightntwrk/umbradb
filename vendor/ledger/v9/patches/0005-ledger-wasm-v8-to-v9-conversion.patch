diff --git a/Cargo.toml b/Cargo.toml
index edeef4c..822e43f 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -72,6 +72,14 @@ midnight-serialize = { path = "serialize" }
 # The pinned midnight-zkir asks crates.io for transient-crypto 3.0.0, which is
 # unpublished; resolve it to the in-tree copy.
 midnight-transient-crypto = { path = "transient-crypto" }
+# UmbraDB: the v8 -> v9 state translation (a git dependency of ledger-wasm) depends on the v9
+# crates through crates.io; resolve them to this workspace, as midnight-node 2.1.101 resolves them
+# to their crates.io releases from this tree, so that the translation links this v9 ledger. Ledger
+# v8 8.1.3 and its storage 2.0.5 (crates.io) share this tree's storage-core, and so one arena.
+midnight-ledger-v9 = { path = "ledger" }
+midnight-onchain-state = { path = "onchain-state" }
+midnight-storage = { path = "storage" }
+midnight-storage-core = { path = "storage-core" }
 
 [workspace.metadata.spellcheck]
 config = ".spellcheck/cargo-spellcheck.toml"
