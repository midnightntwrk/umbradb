+/// (UmbraDB) `PreComputedRoundCPU::init()` for the field `F`, computed once per thread and field type and copied
+/// from then on. It is a function of the field's parameters alone, so every hash gets the value it computed itself
+/// before.
+fn kept_pre_computed<F: PoseidonField>() -> PreComputedRoundCPU<F> {
+    use std::any::{Any, TypeId};
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    thread_local! {
+        static KEPT: RefCell<HashMap<TypeId, Box<dyn Any>>> = RefCell::new(HashMap::new());
+    }
+    KEPT.with(|kept| {
+        let mut kept = kept.borrow_mut();
+        *kept
+            .entry(TypeId::of::<F>())
+            .or_insert_with(|| Box::new(PreComputedRoundCPU::<F>::init()))
+            .downcast_ref::<PreComputedRoundCPU<F>>()
+            .expect("one pre-computation per field type")
+    })
+}
