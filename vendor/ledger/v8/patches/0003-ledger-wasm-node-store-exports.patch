+// UmbraDB additions: keeping the ledger state in a node store outside this module.
+
+/**
+ * A synchronous store of ledger nodes, as in the node's `layout-v2` storage: a node is stored
+ * under its 32-byte key with its binary payload and the serialization of its child list.
+ * `get` must not call into this module.
+ */
+export interface NodeStore {
+  get(key: Uint8Array): { data: Uint8Array; children: Uint8Array } | null;
+}
+
+/**
+ * The nodes created since the previous flush that a key whose root count rose reaches, and the
+ * net root-count change of every key changed since then; both in key order.
+ */
+export interface NodeBatch {
+  inserts: { key: Uint8Array; data: Uint8Array; children: Uint8Array }[];
+  rootCounts: { key: Uint8Array; delta: number }[];
+}
+
+/**
+ * Loads the ledger state whose root node has key `stateKey`, reading nodes from `store` as they
+ * are needed; the store stays installed for later reads. A node that does not match its key
+ * aborts the module.
+ */
+export function loadState(stateKey: Uint8Array, store: NodeStore): LedgerState;
+
+/** The state root the node reports for this state (`midnight_ledgerStateRoot`). */
+export function stateRoot(state: LedgerState): Uint8Array;
+
+/** The 32-byte key of this state's root node; the node is kept until the next `flushNodes`. */
+export function stateKey(state: LedgerState): Uint8Array;
+
+/** Takes the pending nodes reachable from keys persisted since the previous flush. */
+export function flushNodes(): NodeBatch;
+
+/** Raises the root count of `key` by one. */
+export function persistKey(key: Uint8Array): void;
+
+/** Lowers the root count of `key` by one. */
+export function releaseKey(key: Uint8Array): void;
+
+/** The keys of the by-reference children in a serialized child list, through embedded children. */
+export function childRefs(children: Uint8Array): Uint8Array[];
+
+/** Drops nodes deleted from the store from this module's caches; fails if one is still in use. */
+export function evictKeys(keys: Uint8Array[]): void;
+
+/** The key of the node holding a contract's state, or `null` without that contract. */
+export function contractStateKey(state: LedgerState, address: Uint8Array): Uint8Array | null;
+
+/** The key of the node holding a contract's zswap state, or `null` without that contract. */
+export function contractZswapStateKey(state: LedgerState, address: Uint8Array): Uint8Array | null;
