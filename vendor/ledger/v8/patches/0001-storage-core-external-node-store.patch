+    /// Wrap a lookup function.
+    pub fn new(
+        lookup: impl Fn(&ArenaHash<H>) -> Option<SourcedNode<H>> + Send + Sync + 'static,
+    ) -> Self {
+        NodeSource(std::sync::Arc::new(lookup))
+    }
+}
