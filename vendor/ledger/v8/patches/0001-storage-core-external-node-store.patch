+    /// Forget the in-memory copies of objects that were deleted from the store, so that each is
+    /// created, and taken by [`StorageBackend::take_reachable_pending`], again if it is needed
+    /// again (see [`StorageBackend::forget_stored`]).
+    ///
+    /// Fails, changing nothing, with the first key that an `Sp` in this arena still holds: an
+    /// object that is still in use must stay readable, so it must not have been deleted.
+    pub fn forget_stored(
+        &self,
+        keys: &[ArenaHash<D::Hasher>],
+    ) -> Result<(), ArenaHash<D::Hasher>> {
+        let metadata = self.lock_metadata();
+        if let Some(live) = keys
+            .iter()
+            .find(|key| RefCell::borrow(&metadata).contains_key(*key))
+        {
+            return Err(live.clone());
+        }
+        let backend = self.lock_backend();
+        let mut backend = RefCell::borrow_mut(&backend);
+        for key in keys {
+            backend.forget_stored(key);
+        }
+        Ok(())
+    }
