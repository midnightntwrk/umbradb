+
+// The node's end-of-block update (UmbraDB task 12.1a, owner decision Q113 A). The published
+// `LedgerParameters.normalizeFullness` and `LedgerState.postBlockUpdate` pass a block's fullness
+// through JavaScript numbers, whose 53 bits cannot hold a `FixedPoint`'s, and refuse a block
+// above its limits; the published `SystemTransaction` has no cost. These follow `midnight-node`
+// 2.1.0-rc.4 instead, so that the fee prices after a block, and with them the state root, are
+// the node's.
+
+/// A block's fullness as the node computes it at the end of a block: each dimension of `cost`,
+/// the summed cost of the block's transactions, clamped to the block limit and normalized to it
+/// (`midnight-node` `ledger/helpers/src/ledger_8/mod.rs` `clamp_and_normalize`), and the largest
+/// dimension (`compute_overall_fullness`). Where the node's `expect` would panic (a zero limit),
+/// this returns an error.
+fn node_block_fullness(
+    cost: &SyntheticCost,
+    limits: &SyntheticCost,
+) -> Result<(NormalizedCost, FixedPoint), JsError> {
+    let clamped = SyntheticCost {
+        read_time: cost.read_time.min(limits.read_time),
+        compute_time: cost.compute_time.min(limits.compute_time),
+        block_usage: cost.block_usage.min(limits.block_usage),
+        bytes_written: cost.bytes_written.min(limits.bytes_written),
+        bytes_churned: cost.bytes_churned.min(limits.bytes_churned),
+    };
+    let normalized = clamped
+        .normalize(*limits)
+        .ok_or_else(|| JsError::new("a block limit of zero: the fullness cannot be normalized"))?;
+    let overall = FixedPoint::max(
+        FixedPoint::max(
+            FixedPoint::max(normalized.read_time, normalized.compute_time),
+            normalized.block_usage,
+        ),
+        FixedPoint::max(normalized.bytes_written, normalized.bytes_churned),
+    );
+    Ok((normalized, overall))
+}
+
+/// A `FixedPoint` as the integer `value × 2^64` it holds (its serialization is that `i128`,
+/// little-endian), as a JavaScript `bigint`.
+fn fixed_point_bits(value: FixedPoint) -> Result<BigInt, JsError> {
+    let mut bytes = Vec::with_capacity(16);
+    Serializable::serialize(&value, &mut bytes)?;
+    let bits: [u8; 16] = bytes
+        .as_slice()
+        .try_into()
+        .map_err(|_| JsError::new("a FixedPoint serializes to 16 bytes"))?;
+    Ok(BigInt::from(i128::from_le_bytes(bits)))
+}
+
+/// The fullness the node's post-block update takes for a block whose transactions cost
+/// `fullness` in all, against the block limits of `params`: `{ readTime, computeTime, blockUsage,
+/// bytesWritten, bytesChurned, overall }`, each a `FixedPoint` as the integer `value × 2^64` it
+/// holds.
+#[wasm_bindgen(js_name = "blockFullness")]
+pub fn block_fullness(params: &LedgerParameters, fullness: JsValue) -> Result<JsValue, JsError> {
+    report_panics();
+    let cost: SyntheticCost = from_value(fullness)?;
+    let (normalized, overall) = node_block_fullness(&cost, &params.limits.block_limits)?;
+    let result = Object::new();
+    for (field, value) in [
+        ("readTime", normalized.read_time),
+        ("computeTime", normalized.compute_time),
+        ("blockUsage", normalized.block_usage),
+        ("bytesWritten", normalized.bytes_written),
+        ("bytesChurned", normalized.bytes_churned),
+        ("overall", overall),
+    ] {
+        set_field(&result, field, &fixed_point_bits(value)?.into())?;
+    }
+    Ok(result.into())
+}
+
+/// The post-block update the node runs at the end of every block (`midnight-node`
+/// `ledger/src/ledger_8/api/ledger.rs` `Ledger::apply_post_block_update`, which
+/// `pallet-midnight`'s `on_finalize` calls, and `ledger/src/ledger_8/post_block_update.rs`
+/// `apply_post_block_update`): `fullness`, the summed cost of the block's transactions, as
+/// `blockFullness` gives it against this state's block limits (clamped, never refused), then
+/// the ledger's `post_block_update`, which a clamped fullness cannot make refuse at `tblock`.
+#[wasm_bindgen(js_name = "postBlockUpdateExact")]
+pub fn post_block_update_exact(
+    state: &LedgerState,
+    tblock: &Date,
+    fullness: JsValue,
+) -> Result<LedgerState, JsError> {
+    report_panics();
+    let cost: SyntheticCost = from_value(fullness)?;
+    let (normalized, overall) =
+        node_block_fullness(&cost, &state.0.parameters.limits.block_limits)?;
+    let tblock = Timestamp::from_secs(js_date_to_seconds(tblock));
+    Ok(LedgerState(state.0.post_block_update(tblock, normalized, overall)?))
+}
+
+/// A system transaction's cost, which the node adds to the block's fullness (`midnight-node`
+/// `ledger/src/ledger_8/api/ledger.rs` `Ledger::apply_system_tx`: `tx.cost(&sp.state.parameters)`,
+/// with the parameters of the state before it applies).
+#[wasm_bindgen(js_name = "systemTransactionCost")]
+pub fn system_transaction_cost(
+    transaction: &SystemTransaction,
+    params: &LedgerParameters,
+) -> Result<JsValue, JsError> {
+    report_panics();
+    Ok(to_value(&transaction.0.cost(params))?)
+}
